      "public": false,
      "parser": "HDWing",
      "schema": "NexusPhp",
      "language": "zh",
      "encoding": "UTF-8",
      "search": {
        "paths": [
          {
            "path": "torrents.php",
            "method": "get"
          }
        ],
        "params": {
